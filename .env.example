# Docker Compose real mode: absolute path to a clean, committed Git repository.
# Copy to .env and edit, or use scripts/devflow.ps1 -Repository / devflow.sh --repository.
# Windows example: DEVFLOW_PROJECT_PATH=F:/projects/my-project
DEVFLOW_PROJECT_PATH=/absolute/path/to/my-project
# Direct Compose only; launchers use -Port / --port (default 3000).
# Loopback listener and backend allowed origin change together.
DEVFLOW_PORT=3000
# Provider credentials are entered through local setup, NOT this file.
# Backend settings live in the dedicated devflow-secrets volume.
